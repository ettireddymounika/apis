

CREATE COMPUTE MODULE getEnquiryRes
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- CALL CopyMessageHeaders();
		-- CALL CopyEntireMessage();
		
		DECLARE inGetEnqRef	REFERENCE TO InputRoot.XMLNSC.*:Envelope.*:Body.*:GetEnquiryRes;
		DECLARE envRef		REFERENCE TO Environment.Variables[>];
		
		CREATE FIELD OutputRoot.JSON.Data.response;
		DECLARE outRespRef , outgetEnquiryRef , outErrorRef , outItemRef REFERENCE TO OutputRoot.JSON.Data.response; 
		CALL JsonHeader(outRespRef , envRef);  
		
		IF inGetEnqRef.*:ResponseHeader.*:ResponseCode= 'IBL00001' THEN
			CREATE LASTCHILD OF outRespRef.body AS outgetEnquiryRef NAME 'getEnquiryRes';
			
				SET outgetEnquiryRef.responseCode 	    = COALESCE(inGetEnqRef.*:ResponseHeader.*:ResponseCode , '');
				SET outgetEnquiryRef.responseMsg   	    = COALESCE(inGetEnqRef.*:ResponseHeader.*:ResponseMsg , '');
				SET outgetEnquiryRef.accountNumber   	= COALESCE(inGetEnqRef.*:AccountNumber , '');
				SET outgetEnquiryRef.cardNumber   	    = COALESCE(inGetEnqRef.*:CardNumber , '');
				SET outgetEnquiryRef.redeemablePoints   = COALESCE(inGetEnqRef.*:RedeemablePoints , '');
		 ELSE
			SET outRespRef.header.status = 'Failed';
			CREATE LASTCHILD OF outRespRef AS outErrorRef IDENTITY (JSON.Array)error;
				CREATE LASTCHILD OF outErrorRef AS outItemRef NAME 'Item';
					SET outItemRef.errorCode = COALESCE(inGetEnqRef.*:ResponseHeader.*:ResponseCode , ''); 
					SET outItemRef.errorDesc = COALESCE(inGetEnqRef.*:ResponseHeader.*:ResponseMsg , ''); 
				IF EXISTS(inGetEnqRef.*:Exceptions[]) THEN 
					DECLARE inExecRef REFERENCE TO inGetEnqRef.Exceptions.Exception[>];
					WHILE LASTMOVE(inExecRef) DO
						CREATE LASTCHILD OF outErrorRef AS outItemRef NAME 'Item';
							SET outItemRef.errorCode = COALESCE(inExecRef.*:ErrorCode , '');
							SET outItemRef.errorDesc = COALESCE(inExecRef.*:ErrorMessage , '');
						MOVE inExecRef NEXTSIBLING REPEAT NAME;
					END WHILE;
				END IF;	
		END IF;      	
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;

CREATE PROCEDURE JsonHeader(INOUT outRespRef REFERENCE , IN envRef REFERENCE) BEGIN
	DECLARE outHdrRef REFERENCE TO outRespRef;  
	CREATE LASTCHILD OF outRespRef AS outHdrRef NAME 'header';   
		SET outHdrRef.requestUUID 	= envRef.RequestID;
		SET outHdrRef.channelId 	= envRef.ChannelID;
		SET outHdrRef.status 		= 'success'; 
END; 